# ─────────────────────────────────────────────────────────────────────────────
# Recomenda — modelo de variáveis de ambiente.
# Copie para .env (ou defina no painel do provedor de deploy) e ajuste os valores.
# Todas são NEXT_PUBLIC_* (públicas, embutidas no bundle do navegador).
# ─────────────────────────────────────────────────────────────────────────────

# Domínio de produção — usado no metadata/Open Graph e na barra de endereço do mock
NEXT_PUBLIC_SITE_URL=https://recomenda.vercel.app

# Acesso à plataforma web (agrônomo/admin)
NEXT_PUBLIC_APP_URL=https://recomenda.vercel.app/login

# E-mail de contato exibido na landing page
NEXT_PUBLIC_CONTACT_EMAIL=contato@250k.agr.br
